# ──────────────────────────────────────────────────────────────────────────
# .gitignore do monorepo (Fases 0–5). Repositório PRIVADO, mas mesmo assim
# NÃO versiona segredos reais nem artefatos pesados.
# ──────────────────────────────────────────────────────────────────────────

# === SEGREDOS (nunca commitar) ===
SEGREDOS_LOCAIS.md
# script de diagnóstico com a senha da VPS (uso local)
_vps_probe.py
# .env reais nunca; .env.example e .env.docker (valores FAKE) são versionados
**/.env
**/.env.*
!**/.env.example
!**/.env.docker
# Template de producao (T3.1): so NOMES de variavel e comentarios, sem
# valor secreto. Ficava ignorado por `**/.env.*` e a documentacao dele
# vivia so na maquina de quem editou.
!**/.env.production.example

# Arquivos com segredos REAIS (mantidos só localmente, ver SEGREDOS_LOCAIS.md)
api-app-gc/instruções api-siav.txt
app-gas-em-casa/google-services.json
app-gas-em-casa/GoogleService-Info.plist

# === Dependências / artefatos (pesados, reinstaláveis) ===
**/vendor/
**/node_modules/
**/vendor_fork/
**/composer-setup.php

# === Laravel runtime ===
**/storage/*.key
**/storage/framework/cache/*
**/storage/framework/sessions/*
**/storage/framework/views/*
**/storage/logs/*
**/bootstrap/cache/*.php
**/public/storage

# === Build mobile (nativo, regenerável) ===
app-gas-em-casa/android/
app-gas-em-casa/ios/
app-gas-em-casa/.expo/

# === Locks pesados de JS (opcional manter; aqui versionamos só o do front) ===
**/yarn-error.log
**/npm-debug.log

# === IDE / SO ===
.idea/
.vscode/
.DS_Store
*.swp
Thumbs.db
_migra_monitora.py

# Apps legados descobertos em 2026-08-20 (referencia, nao buildados aqui).
# Segredos e caches ficam fora: google-services.json tem chave do Firebase e
# o repo faz deploy automatico na main.
legado-nfweb/android/app/google-services*.json
legado-movelapp/app/google-services*.json
legado-*/.gradle/
legado-*/app/build/
legado-*/android/app/debug.keystore*
