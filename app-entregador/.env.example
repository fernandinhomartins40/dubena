# Configuração do App do Entregador (P7). Copie para `.env` e preencha.
# `.env` está no .gitignore — NUNCA versione segredos reais.

# Ambiente: local | homolog | prod
APP_ENV=prod

# Base da API do ERP-NOVO (com a barra final). Deve ser HTTPS em homolog/prod.
# Ex. local:   http://192.168.0.108:8000/api/
# Ex. prod:    https://app.seu-erp.com.br/api/
API_URL=https://app.seu-erp.com.br/api/

# Chave do Google Maps. NUNCA versione o valor: em build EAS ela vem do secret
# (`eas secret:create --name GOOGLE_MAPS_API_KEY`), referenciado no eas.json.
# No console do Google, restrinja por package name + SHA-1 (Android), bundle ID
# (iOS) e por API (Maps SDK, Geocoding).
GOOGLE_MAPS_API_KEY=

# Habilita atalhos de debug. Sempre "false" em prod.
APP_DEBUG=false

# Credencial do atalho "Modo teste" da tela de login (só dev). Deixe VAZIO:
# preenchida, ela entra no bundle. Sem as duas, o atalho não é renderizado —
# nem mesmo com APP_DEBUG=true.
LOGIN_TESTE_EMAIL=
LOGIN_TESTE_SENHA=

# Tempo real (Laravel Reverb — protocolo Pusher). Opcional: sem isto, o app
# acompanha por polling. Em prod, aponte para o servidor Reverb do ERP-NOVO.
REVERB_APP_KEY=
REVERB_HOST=
REVERB_PORT=443
REVERB_SCHEME=https
