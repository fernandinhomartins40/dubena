{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "channel": "preview",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_ENV": "homolog",
        "API_URL": "https://gasemcasa.com/novo/api/",
        "GOOGLE_MAPS_API_KEY": "$GOOGLE_MAPS_API_KEY",
        "APP_DEBUG": "true"
      }
    },
    "production": {
      "channel": "production",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "APP_ENV": "prod"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
