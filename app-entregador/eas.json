{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "channel": "preview",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_ENV": "homolog",
        "API_URL": "https://gasemcasa.com/novo/api/",
        "APP_DEBUG": "true"
      },
      "environment": "preview"
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "resourceClass": "m-medium"
      },
      "env": {
        "APP_ENV": "prod",
        "APP_DEBUG": "false",
        "API_URL": "https://gasemcasa.com/novo/api/",
        "REVERB_HOST": "gasemcasa.com",
        "REVERB_PORT": "443",
        "REVERB_SCHEME": "https",
        "REVERB_PATH": "/reverb"
      },
      "environment": "production"
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "production",
        "releaseStatus": "draft"
      },
      "ios": {}
    }
  }
}
