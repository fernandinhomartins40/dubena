# ──────────────────────────────────────────────────────────────────────────
# Template de ambiente para o container (dev/staging) do api-app-gc.
# O entrypoint copia para .env na 1ª subida e gera a APP_KEY.
# ⚠️ Valores de DEV (fake). NÃO colocar credenciais reais aqui.
# ⚠️ Antes de EXPOR na VPS: APP_DEBUG=false (ver README.docker.md).
# ──────────────────────────────────────────────────────────────────────────
APP_NAME="Integracao de Vendas"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8081
APP_TIMEZONE=America/Sao_Paulo
# APP_KEY não é definida aqui de propósito (o entrypoint gera no .env real).

LOG_CHANNEL=stack

# Banco principal (sgcm_api)
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=sgcm_api
DB_USERNAME=sgcm
DB_PASSWORD=sgcm_dev_pwd

# Banco de logs (sgcm_logs) — mesmo servidor, outro database
DB_CONNECTION_LOGS=sgcm_logs
DB_HOST_LOGS=db
DB_PORT_LOGS=3306
DB_DATABASE_LOGS=sgcm_logs
DB_USERNAME_LOGS=sgcm
DB_PASSWORD_LOGS=sgcm_dev_pwd

BROADCAST_DRIVER=log
CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_DRIVER=sync

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_DRIVER=log
MAIL_HOST=null
MAIL_PORT=null
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null

# ⚠️ Integrações externas (Google Maps, FCM) — preencher com chaves de DEV/teste,
# NUNCA as de produção. As que vazaram no Git devem ser rotacionadas.
GMAPS_KEY=
FCM_SERVER_KEY=
FCM_URL=https://fcm.googleapis.com/fcm/send

# Usuário padrão do app para gerar token (dev) — ver achado de segurança S2.
DEFAULT_USER_SYSTEM=dev@local.test
DEFAULT_PASSWORD_SYSTEM=devpassword
DEFAULT_USER_ID=1

# FASE 1 (segurança — S2): segredo PRÓPRIO usado pelo app para obter token,
# desacoplado da APP_KEY. Em dev é fake; na VPS use segredo forte e rotacione
# junto com a build do app. O app envia este valor no parâmetro `app_key`.
APP_TOKEN_KEY=dev_app_token_key_change_me
