<template>
    <div>
        <div class="">
            <div class="card card-default">
                <div class="card-header">
                    <div class="title-display">
                        <span></span>
                        <button class="btn btn-geral btn-sm" @click="actions__Name('create')"></button>
                    </div>
                </div>
                <div class="card-body">
                    <div class="table-scroll">
                        <table class="table table-condensed table-bordered mb-0" v-if="__names.length > 0">
                            <thead>
                            <tr>
                                <th>ID</th>
                                <th style="width: 150px">Ações</th>
                            </tr>
                            </thead>
                            <tbody>
                            <tr v-for="__name in __names" :key="__name.id" :id="'__nameRow' + __name.id">
                                <td>{{ __name.id }}</td>
                                <td>
                                    <button class="btn btn-xs btn-dark" type="button" @click="edit(__name)">Editar <font-awesome-icon icon="edit" /></button>
                                </td>
                            </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        <div class="modal fade" data-backdrop="static" data-keyboard="false" tabindex="-1" role="dialog" id="__name_modal">
            <div class="modal-dialog modal-lg" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h4 class="modal-title" id="header-action"></h4>
                        <button type="button" class="close close-modal" aria-label="Close"><span
                                    aria-hidden="true">&times;</span></button>
                    </div>
                    <div class="modal-body">

                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-danger close-modal">Cancelar</button>
                        <button type="button" class="btn btn-dark" @click="save" id="btnSave"></button>
                    </div>
                </div><!-- /.modal-content -->
            </div><!-- /.modal-dialog -->
        </div><!-- /.modal -->
    </div>
</template>

<script>
    import { helpers } from '../../helpers';
    import { library } from '@fortawesome/fontawesome-svg-core';
    import { faEdit } from '@fortawesome/free-solid-svg-icons';
    import { FontAwesomeIcon } from '@fortawesome/vue-fontawesome';

    library.add(faEdit);

    export default {

        props: ["dataModel", "pageTitle"],
        mixins: [helpers],
        name: '__Name',
        components: { FontAwesomeIcon },

        data() {
            return {
                editing__Name: {},
                action: "",
                submitted: false,
                __names: [],
                __nameModel: {},
            }
        },
        mounted: function ()
        {
            this.initialize();
        },

        methods: {
            initialize()
            {
                if ( typeof this.dataModel === "string" ) {
                    this.__names = JSON.parse(this.dataModel);
                }

            },
            edit(__name)
            {
                let obj = {};
                for (let key in __name) {
                    obj[key] = __name[key];
                }
                this.editing__Name = obj;

                this.actions__Name('edit', __name.id);
            },
            errorHttpFn() {
                return (error) => {
                    this.submitted = false;
                    this.treatErrorsHttp(error);
                };
            },
            successHttpFn(successCallback) {
                return (response) => {
                    if (response.status === 200) {
                        let data = response.data;
                        if (typeof data.status === "string" && data.status === "OK") {
                            if (typeof successCallback === "function") {
                                successCallback(data);
                            } else {
                                this.editing__Name = data.data;
                                this.successAlert("Operação realizada com sucesso!", () => {
                                    location.reload();
                                });
                            }
                            this.$Progress.finish();
                        } else if (typeof data.status === "string" && data.status === "NOK") {
                            this.treatErrorsHttp(data.msg);
                            this.$Progress.fail();
                        } else {
                            this.treatErrorsHttp(data);
                            this.$Progress.fail();
                        }
                    } else {
                        this.treatErrorsHttp(response);
                    }
                    this.submitted = false;
                }
            },
            save()
            {
                if (this.submitted) {
                    return;
                }
                if (this.action === "create") {
                    this.store__Name();
                } else {
                    this.update__Name();
                }
            },
            update__Name()
            {
                let url = this.getUrl() + "/" + this.editing__Name.id;
                this.startRequest();
                let data = this.editing__Name;
                this.patch(url, data).then(this.successHttpFn()).catch(this.errorHttpFn());
            },
            startRequest() {
                this.$Progress.start();
                this.submitted = true;
            },
            store__Name()
            {
                let url = this.getUrl();
                this.startRequest();
                let data = this.editing__Name;
                this.post(url, data).then(this.successHttpFn()).catch(this.errorHttpFn());
            },
            actions__Name(action, __name_id)
            {
                this.__name_id = __name_id || "";
                this.action = action;
                this.notificationOnExit = true;
                if (action === "create") {
                    this.editing__Name = {};
                    $("#header-action").html("Novo");
                } else {
                    $("#header-action").html("Editar");
                }
                $("#__name_modal").modal("show");
            }
        }
    }
</script>