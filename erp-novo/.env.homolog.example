# ──────────────────────────────────────────────────────────────────────────
# erp-novo — TEMPLATE do .env de HOMOLOGAÇÃO (VPS).
#
# COMO USAR: copie este conteúdo para a VPS em:
#     /opt/dubena-env/erp-novo-homolog.env
# preencha os segredos (APP_KEY, DB_PASSWORD) e NÃO versione o arquivo real.
# O workflow de deploy copia esse arquivo para erp-novo/.env a cada deploy.
# ──────────────────────────────────────────────────────────────────────────

APP_IMAGE=registry.example/erpnovo-app@sha256:SUBSTITUA_PELO_DIGEST_DE_64_HEXADECIMAIS
WEB_IMAGE=registry.example/erpnovo-web@sha256:SUBSTITUA_PELO_DIGEST_DE_64_HEXADECIMAIS
APP_NAME="ERP Gas em Casa (Homolog)"
APP_ENV=homologation
APP_KEY=                         # gerar 1x: php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://homolog-erp.gasemcasa.com.br

LOG_CHANNEL=stack
LOG_LEVEL=info

# ── Banco PRÓPRIO do erp-novo (Postgres do docker-compose.homolog.yml) ──
# host = nome do serviço na rede do compose (NÃO 127.0.0.1).
#
# ISOLAMENTO MULTI-TENANT (RLS): o RUNTIME conecta com a role RESTRITA `erp_app`
# (NOSUPERUSER/NOBYPASSRLS) — obrigatório para o Row-Level Security do Postgres
# valer (superuser/bypassrls IGNORA RLS e vazaria dados entre empresas).
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=erp_novo
DB_USERNAME=erp_app              # role restrita (runtime) — criada pela migration
DB_PASSWORD=                     # = RLS_APP_DB_PASSWORD (mesma senha do erp_app)

# Senha que a migration usa para CRIAR/atualizar a role erp_app. Deve ser igual
# ao DB_PASSWORD acima (é a mesma role). Sem ela, a migration da role é NO-OP.
RLS_APP_DB_PASSWORD=             # = DB_PASSWORD

# ── Conexão de OWNER (só migrations/DDL) ──
# Role dona do schema (pode ser superuser). Usada por `migrate --database=pgsql_owner`.
# É o antigo DB_USERNAME=erp. NÃO usar em runtime.
DB_OWNER_USERNAME=erp
DB_OWNER_PASSWORD=               # senha do erp (owner) — segredo forte

# ── Conexão de LEITURA do legado (apenas para ETL; opcional em homolog) ──
# Aponta para o Postgres do ctrl-web. Deixe em branco se ainda não for migrar.
LEGADO_DB_HOST=
LEGADO_DB_PORT=5432
LEGADO_DB_DATABASE=ctrl
LEGADO_DB_USERNAME=ctrl
LEGADO_DB_PASSWORD=
LEGADO_DB_SSLMODE=prefer

# ── Cache / sessão / fila ──
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=                  # obrigatoria: 32+ caracteres base64url

# Tempo real: o container Reverb faz parte da homologacao e nao pode cair em log.
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=               # obrigatoria: 32+ caracteres
REVERB_HOST=homolog-erp.gasemcasa.com.br
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# ── Sanctum (SPA/API) ──
SANCTUM_STATEFUL_DOMAINS=homolog-erp.gasemcasa.com.br
SESSION_DOMAIN=.gasemcasa.com.br

# Webhook PABX: segredo temporariamente vinculado a um unico owner (F0-04).
PABX_WEBHOOK_SECRET=
PABX_EMPRESA_ID=

# Transformacao SaaS: homologacao tambem fica fail-closed por padrao.
SAAS_FREEZE_MIGRATION_WRITES=true
SAAS_FREEZE_COMPANY_CREATION=true

# Scripts de snapshot/conversao (injetados explicitamente no processo Python).
ORACLE_CONNECTION=
ETL_PG_DSN=
MONITORA_MYSQL_HOST=
MONITORA_MYSQL_PORT=3306
MONITORA_MYSQL_USER=
MONITORA_MYSQL_PASSWORD=
MONITORA_MYSQL_DATABASE=
