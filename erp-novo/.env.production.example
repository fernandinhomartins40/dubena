# =============================================================================
# ERP-NOVO — TEMPLATE DO .env DE PRODUCAO  (T3.1 do PLANO_PRODUCAO)
# =============================================================================
#
# O arquivo REAL vive em /opt/dubena-env/erp-novo-producao.env na VPS e NUNCA e
# commitado. Este template existe para que nenhuma chave usada pelo codigo fique
# sem decisao — a auditoria encontrou 15+ variaveis consumidas por `env()` sem
# aparecer em nenhum example, e o efeito de deixa-las vazias ia de "e-mail nao
# sai" a "a migration que cria a role restrita vira NO-OP silencioso".
#
# LEGENDA
#   [OBRIGATORIA]  sem ela o sistema nao sobe, ou sobe INSEGURO/QUEBRADO
#   [IMPORTANTE]   funciona sem, mas degradado (sem e-mail, sem tempo real...)
#   [OPCIONAL]     default do framework serve
#
# Cada chave critica traz o EFEITO de deixa-la vazia, nao so o nome.
# =============================================================================

# -----------------------------------------------------------------------------
# APLICACAO
# -----------------------------------------------------------------------------
APP_NAME="Gas em Casa"
APP_ENV=production                  # [OBRIGATORIA] muda o comportamento de TODOS os gates de fail-close (F1)
APP_KEY=                            # [OBRIGATORIA] `php artisan key:generate`. Vazia = sessao/criptografia quebradas
APP_DEBUG=false                     # [OBRIGATORIA] true em producao expor stack trace com credenciais
APP_URL=https://gasemcasa.com/novo
APP_TIMEZONE=America/Sao_Paulo
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR
# APP_PREVIOUS_KEYS=                # [OPCIONAL] chaves antigas, para rotacionar APP_KEY sem invalidar sessoes
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=

# -----------------------------------------------------------------------------
# BANCO — runtime
# -----------------------------------------------------------------------------
# ATENCAO: o runtime usa a role RESTRITA `erp_app` (NOSUPERUSER NOBYPASSRLS).
# E isso que faz a RLS multi-tenant ser defesa real: superuser IGNORA RLS.
# Migrations rodam separadamente, com --database=pgsql_owner.
DB_CONNECTION=pgsql                 # [OBRIGATORIA]
DB_HOST=db
DB_PORT=5432
DB_DATABASE=erp_novo
DB_USERNAME=erp_app                 # [OBRIGATORIA] NUNCA o owner do banco
DB_PASSWORD=                        # [OBRIGATORIA]
# DB_URL=
# DB_CHARSET / DB_COLLATION / DB_SOCKET       [OPCIONAL]
# DB_SSLMODE=                                 [OPCIONAL] `require` se o banco for remoto
# DB_ENCRYPT / DB_TRUST_SERVER_CERTIFICATE    [OPCIONAL] so SQL Server
# DB_FOREIGN_KEYS                             [OPCIONAL] so sqlite
# DB_CACHE_TABLE / DB_CACHE_CONNECTION / DB_CACHE_LOCK_TABLE / DB_CACHE_LOCK_CONNECTION
# DB_QUEUE / DB_QUEUE_TABLE / DB_QUEUE_CONNECTION
#   [OPCIONAL] so se CACHE_STORE/QUEUE_CONNECTION forem `database` (aqui e redis)

# Conexao do OWNER — so para migrations (`migrate --database=pgsql_owner`).
DB_OWNER_URL=                       # [OBRIGATORIA] DSN do dono do schema
# DB_OWNER_HOST / DB_OWNER_PORT / DB_OWNER_DATABASE / DB_OWNER_USERNAME / DB_OWNER_PASSWORD

# Senha da role restrita, lida pela migration que a cria.
# ATENCAO: `2026_06_26_000400_rls_role_app_sem_bypass.php:33` le env() DIRETO —
# se estiver vazia a migration vira NO-OP SILENCIOSO e a RLS nao protege nada.
# O proprio golive:check trata isso como causa-raiz de FAIL.
RLS_APP_DB_PASSWORD=                # [OBRIGATORIA]

# -----------------------------------------------------------------------------
# BANCOS LEGADOS — so para o ETL de migracao (podem ficar vazios em regime)
# -----------------------------------------------------------------------------
# O espelho do Oracle vive no MESMO banco da aplicacao, num schema separado
# (`legado`). Portanto HOST/DATABASE/USERNAME/PASSWORD sao OS MESMOS do DB_* —
# nao aponte para um banco `ctrl` separado.
#
# ARMADILHA VERIFICADA EM 18/08/2026: os defaults de `config/database.php` sao
# host=127.0.0.1, database=ctrl, username=ctrl. Preencher com eles (ou deixar em
# branco e herdar o default) faz a conexao apontar para um banco que NAO EXISTE.
# O sintoma nao e erro na tela: os migrators avisam "tabela ausente no espelho"
# e PULAM — telas de colaboradores, frota, plano de contas e centro de custo
# ficam VAZIAS sem nenhum erro visivel.
LEGADO_DB_SCHEMA=legado             # [OBRIGATORIA p/ ETL] default do config e `public` — ERRADO aqui
LEGADO_DB_HOST=db                   # o mesmo de DB_HOST
LEGADO_DB_PORT=5432
LEGADO_DB_DATABASE=erp_novo         # o mesmo de DB_DATABASE
LEGADO_DB_USERNAME=erp_app          # o mesmo de DB_USERNAME
LEGADO_DB_PASSWORD=                 # o mesmo de DB_PASSWORD
# LEGADO_DB_CHARSET / LEGADO_DB_SSLMODE   [OPCIONAL]
#
# A role de runtime precisa de leitura no schema do espelho — o restore o cria
# como propriedade do owner, e sem isto o ETL falha com "relation does not exist":
#   GRANT USAGE ON SCHEMA legado TO erp_app;
#   GRANT SELECT ON ALL TABLES IN SCHEMA legado TO erp_app;
#
# MySQL do app "Gas em Casa" (sgcm_api) — defaults do config sao root/senha vazia:
# APP_LEGADO_DB_HOST=
# APP_LEGADO_DB_PORT=3306
# APP_LEGADO_DB_DATABASE=sgcm_api
# APP_LEGADO_DB_USERNAME=
# APP_LEGADO_DB_PASSWORD=
#
# MySQL do modulo de GPS (monitora) — mesmos defaults inseguros:
# MONITORA_LEGADO_DB_HOST=
# MONITORA_LEGADO_DB_PORT=3306
# MONITORA_LEGADO_DB_DATABASE=monitora
# MONITORA_LEGADO_DB_USERNAME=
# MONITORA_LEGADO_DB_PASSWORD=

# -----------------------------------------------------------------------------
# SESSAO / CACHE / FILA
# -----------------------------------------------------------------------------
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=gasemcasa.com
SESSION_SECURE_COOKIE=true          # [OBRIGATORIA] sem default no config (null); em HTTPS TEM de ser true
SESSION_SAME_SITE=lax
SESSION_HTTP_ONLY=true              # [IMPORTANTE] impede JavaScript de ler o cookie de sessao
# SESSION_STORE / SESSION_CONNECTION / SESSION_TABLE   [OPCIONAL]
# SESSION_EXPIRE_ON_CLOSE / SESSION_PARTITIONED_COOKIE [OPCIONAL]

CACHE_STORE=redis
# CACHE_PREFIX=

QUEUE_CONNECTION=redis
# QUEUE_FAILED_DRIVER=database-uuids
# DB_QUEUE_RETRY_AFTER / REDIS_QUEUE_RETRY_AFTER  — ver T3.3: precisam ser MAIORES
# que o timeout do job mais longo (ExecutarMigracaoJob declara 21600s = 6h)

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=                     # [IMPORTANTE] Redis sem senha na mesma rede docker
# REDIS_URL / REDIS_DB / REDIS_CACHE_DB / REDIS_PREFIX / REDIS_CACHE_CONNECTION
# REDIS_USERNAME / REDIS_PERSISTENT / REDIS_CLUSTER               [OPCIONAL]
# REDIS_QUEUE / REDIS_QUEUE_CONNECTION / REDIS_CACHE_LOCK_CONNECTION  [OPCIONAL]
# REDIS_MAX_RETRIES / REDIS_BACKOFF_ALGORITHM / REDIS_BACKOFF_BASE / REDIS_BACKOFF_CAP

# -----------------------------------------------------------------------------
# AUTENTICACAO / API
# -----------------------------------------------------------------------------
SANCTUM_EXPIRATION=1440             # [OBRIGATORIA] 24h (T1.5). Era 43200 = 30 dias de token vazado
SANCTUM_STATEFUL_DOMAINS=gasemcasa.com
# SANCTUM_TOKEN_PREFIX=             # [OPCIONAL] ajuda scanners de segredo a detectar vazamento
# AUTH_GUARD / AUTH_MODEL / AUTH_PASSWORD_BROKER / AUTH_PASSWORD_TIMEOUT  [OPCIONAL]
# AUTH_PASSWORD_RESET_TOKEN_TABLE   [OPCIONAL]

# CORS: vazio = SO o APP_URL (nunca '*'), que e o correto em producao — a SPA e
# servida do mesmo dominio e os apps usam Bearer (sem cookie, sem CORS).
# Preencha apenas se algum front legitimo rodar em outro dominio.
# CORS_ALLOWED_ORIGINS=             # [OPCIONAL] lista separada por virgula

# -----------------------------------------------------------------------------
# CREDENCIAIS DE BOOTSTRAP (seeders)  — T1.1
# -----------------------------------------------------------------------------
# Em producao sao OBRIGATORIAS e exigem >= 12 caracteres: o seeder ABORTA o
# deploy se faltarem (fail-close). Nunca preencha valores reais neste template.
#
# ATENCAO: os seeders so definem senha na CRIACAO da conta. Uma conta que ja
# existe com senha default NAO e corrigida por aqui — tem de ser trocada a mao.
ADMIN_SEED_EMAIL=admin@gasemcasa.com
ADMIN_SEED_PASSWORD=                # [OBRIGATORIA]
SUPERADMIN_SEED_EMAIL=superadmin@gasemcasa.com
SUPERADMIN_SEED_PASSWORD=           # [OBRIGATORIA] acesso CROSS-TENANT
# OPERADOR_SEED_PASSWORD / DONO_SEED_PASSWORD / GERENTE_SEED_PASSWORD
#   [OPCIONAL] so para seeders de acesso que NAO rodam em producao (T3.7)

# -----------------------------------------------------------------------------
# DRIVERS GATE — fail-close em producao (T1.3)
# -----------------------------------------------------------------------------
# Se o valor nao for o driver REAL, a resolucao do binding lanca RuntimeException
# em producao. Antes disso, o default `fake` significava: login de app forjavel,
# NF-e simulada e CNAB de mentira, sem nenhum sinal.
FIREBASE_DRIVER=kreait              # [OBRIGATORIA] fake = qualquer um loga como qualquer cliente
FIREBASE_PROJECT_ID=                # [OBRIGATORIA] valida a audience do token
FIREBASE_CREDENTIALS=/var/www/storage/app/firebase/service-account.json
#   [OBRIGATORIA] caminho de arquivo NO SERVIDOR (nao versionado). Permissao 0400,
#   dono do processo PHP. Ver T3.10.

FCM_DRIVER=v1                       # [IMPORTANTE] fake = push nao chega ao cliente
# FCM_SERVER_KEY=                   # legado (depreciado pelo Google); v1 usa a service account

FISCAL_DRIVER=nfephp                # [OBRIGATORIA] fake = NAO emite NF-e de verdade
COBRANCA_DRIVER=caixa               # [OBRIGATORIA] caixa|itau. fake = CNAB de mentira
PAGAMENTO_DRIVER=erede              # [IMPORTANTE] fake = cartao indisponivel no app
MONITORA_DRIVER=sgcasa              # [DESEJAVEL] fake = so degrada o GPS (loga warning, nao aborta)

# -----------------------------------------------------------------------------
# PIX  — ATENCAO: sao DOIS segredos distintos
# -----------------------------------------------------------------------------
PIX_ENABLED=true                    # [OBRIGATORIA p/ cobrar]
PIX_DRIVER=                         # [OBRIGATORIA] PSP real
PIX_PSP=
PIX_AMBIENTE=producao               # homologacao|producao
PIX_CLIENT_ID=
PIX_WEBHOOK_SECRET=                 # [OBRIGATORIA] segredo compartilhado do webhook
PIX_WEBHOOK_HMAC_SECRET=            # [OBRIGATORIA] DIFERENTE do anterior — assina o corpo
PIX_WEBHOOK_SIGNATURE_HEADER=X-Webhook-Signature
# A credencial de cobranca e POR EMPRESA, em empresa_configs.dados['integracoes']['pix'].
# Resolucao: EMPRESA -> GRUPO -> PLATAFORMA(env), fail-closed (IntegracaoTenant).

# -----------------------------------------------------------------------------
# TEMPO REAL (Reverb)  — T3.9
# -----------------------------------------------------------------------------
# Sem BROADCAST_CONNECTION o broadcast cai no driver `log` (config/broadcasting.php:16):
# os 5 eventos ShouldBroadcast nao chegam a lugar nenhum e os apps caem para polling.
#
# ATENCAO — as tres chaves abaixo nao sao opcionais para o SERVIDOR subir. Sem
# elas o `reverb:start` inicia, nao encontra nenhum app configurado e MORRE em
# laco: medido em producao, 575 reinicios do container. Gere valores proprios
# (podem ser aleatorios; sao o segredo compartilhado entre servidor e clientes).
BROADCAST_CONNECTION=reverb         # [IMPORTANTE]
REVERB_APP_ID=                      # [OBRIGATORIA se BROADCAST=reverb]
REVERB_APP_KEY=                     # [OBRIGATORIA se BROADCAST=reverb] vai para o bundle dos apps
REVERB_APP_SECRET=                  # [OBRIGATORIA se BROADCAST=reverb] NUNCA sai do servidor
REVERB_HOST=gasemcasa.com           # host PUBLICO (o proxy wss:// aponta para 127.0.0.1:3121)
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
# Os apps mobile precisam ser REBUILDADOS com estes valores em `extra.reverb`
# — sem isso o proxy nao serve para nada.

# -----------------------------------------------------------------------------
# E-MAIL — default e `log`: NADA SAI
# -----------------------------------------------------------------------------
MAIL_MAILER=smtp                    # [IMPORTANTE] `log` = e-mail nenhum e enviado
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS=nao-responda@gasemcasa.com
MAIL_FROM_NAME="${APP_NAME}"
# MAIL_URL / MAIL_EHLO_DOMAIN / MAIL_LOG_CHANNEL / MAIL_SENDMAIL_PATH  [OPCIONAL]
# Ha tambem um mailer POR EMPRESA (empresa_smtp), configurado pela SPA.

# -----------------------------------------------------------------------------
# INTEGRACOES EXTERNAS
# -----------------------------------------------------------------------------
GOOGLE_MAPS_KEY=                    # [IMPORTANTE] sem ela: rota em linha reta (Haversine)
# GEOCODING_API_KEY=                # [OPCIONAL] fallback do GOOGLE_MAPS_KEY
# CONSISA_API_URL=                  # [OPCIONAL] conciliacao contabil; vazio = desabilitada
# IBPT_CSV_URL=                     # [OPCIONAL] atualizacao mensal da tabela IBPT
# EREDE_API_URL / EREDE_PV / EREDE_TOKEN     [IMPORTANTE se PAGAMENTO_DRIVER=erede]
# SGCASA_API_URL / SGCASA_TOKEN              [DESEJAVEL se MONITORA_DRIVER=sgcasa]

# -----------------------------------------------------------------------------
# ARQUIVOS
# -----------------------------------------------------------------------------
# `local` guarda os certificados A1 no volume app_storage — que E copiado pelo
# backup (deploy/backup/backup.sh). Se trocar para s3, revise o backup.
FILESYSTEM_DISK=local
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_DEFAULT_REGION / AWS_BUCKET
# AWS_URL / AWS_ENDPOINT / AWS_USE_PATH_STYLE_ENDPOINT   [OPCIONAL]

# -----------------------------------------------------------------------------
# LOG E OBSERVABILIDADE  — T3.9
# -----------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=daily                     # [IMPORTANTE] `single` = arquivo unico sem rotacao, cresce sem fim
LOG_LEVEL=warning                   # producao: `debug` inunda o disco
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
# LOG_DEPRECATIONS_TRACE / LOG_STDERR_FORMATTER / LOG_SYSLOG_FACILITY  [OPCIONAL]
# LOG_SLACK_WEBHOOK_URL / LOG_SLACK_USERNAME / LOG_SLACK_EMOJI         [OPCIONAL]
# LOG_PAPERTRAIL_HANDLER / PAPERTRAIL_URL / PAPERTRAIL_PORT            [OPCIONAL]

# SENTRY_LARAVEL_DSN=               # [IMPORTANTE] sem isto, erro em producao so aparece no arquivo
# SENTRY_TRACES_SAMPLE_RATE=0.05

# -----------------------------------------------------------------------------
# FRONTEND (SPA) — embutidas no bundle em BUILD TIME
# -----------------------------------------------------------------------------
# Tudo que comeca com VITE_ fica VISIVEL a qualquer visitante. Nunca coloque
# segredo aqui. As credenciais de demonstracao (VITE_DEMO_*) devem ficar VAZIAS:
# o botao so aparece em `npm run dev` e com as duas preenchidas (T1.2).
VITE_APP_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# DELIBERADAMENTE AUSENTES
# -----------------------------------------------------------------------------
# Estas 26 variaveis sao lidas por `env()` nos configs PADRAO do Laravel, mas
# pertencem a drivers que este projeto NAO usa. Ficam listadas para que a
# ausencia seja uma decisao registrada, e nao um esquecimento — foi o implicito
# que produziu os buracos que a auditoria encontrou.
#
#   MEMCACHED_*     cache e redis
#   DYNAMODB_*      cache e redis
#   BEANSTALKD_*    fila e redis
#   SQS_*           fila e redis
#   PUSHER_*        broadcast e reverb (protocolo Pusher, servidor proprio)
#   POSTMARK_*      mail e smtp
#   RESEND_API_KEY  mail e smtp
#   SLACK_BOT_*     sem integracao Slack
#   MYSQL_ATTR_SSL_CA   o banco e Postgres (o MySQL so aparece nas origens do ETL)
#
# Se algum desses drivers for adotado, mova a chave para a secao correspondente.

# -----------------------------------------------------------------------------
# NOTAS DE OPERACAO
# -----------------------------------------------------------------------------
# 1. Backup: cron do host as 03:15 UTC (deploy/backup/instalar-cron.sh).
#    Defina BACKUP_REMOTO no ambiente do cron para replicar FORA do host.
# 2. Depois de editar este arquivo na VPS:
#      docker compose ... exec app php artisan config:cache
#    Com config:cache ativo, `env()` fora de config/ retorna NULL — por isso
#    todo codigo novo deve ler via config(), nunca env() direto.
# 3. Portao final: `php artisan golive:check --strict` tem de sair 0.

# ── Telefonia / bina (T4.4) — condicionado à decisão do dono ──────────────────
# Segredo DEDICADO do webhook do PABX. Não reutilize a APP_KEY: o legado
# autenticava com sha1(APP_KEY) e essa chave vazou no repositório.
# Sem este valor o endpoint /api/pabx/chamada recusa tudo (fail-closed).
PABX_WEBHOOK_SECRET=
