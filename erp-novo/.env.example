APP_NAME="ERP Gas em Casa"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# CORS (S-8): origens permitidas (vírgula). Vazio = só o APP_URL (nunca '*').
# A SPA é same-origin em produção; isto é para o dev cross-origin (Vite :5173).
# CORS_ALLOWED_ORIGINS=http://localhost:5173

# PIX webhook (S-1): HMAC-SHA256 do corpo cru (deixe vazio p/ não exigir HMAC).
# PIX_WEBHOOK_HMAC_SECRET=
# PIX_WEBHOOK_SIGNATURE_HEADER=X-Webhook-Signature

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Dev local/CI: sqlite (sem servidor). Produção: trocar para pgsql (abaixo).
DB_CONNECTION=sqlite
# --- PostgreSQL (banco NOVO) — produção/homologação ---
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=erp_novo
# DB_USERNAME=erp
# DB_PASSWORD=

# --- Banco LEGADO (somente leitura, usado pelo ETL) ---
LEGADO_DB_HOST=127.0.0.1
LEGADO_DB_PORT=5432
LEGADO_DB_DATABASE=ctrl
LEGADO_DB_USERNAME=ctrl
LEGADO_DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# P0 — Infra: em produção use Redis para filas/cache e Reverb para broadcasting.
# Dev/CI podem manter database/log (sem dependência de Redis).
#   QUEUE_CONNECTION=redis  CACHE_STORE=redis  BROADCAST_CONNECTION=reverb
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- GATES de integrações externas (default = fake/desligado; CI/homolog não precisam) ---
# Fiscal (SEFAZ): 'nfephp' ativa emissão real de NF-e/NFC-e (certificado A1 por empresa).
FISCAL_DRIVER=fake
# Cobrança/boleto (CNAB): 'caixa' (104) ou 'itau' (341) ativam o boleto real; senão fake.
# As credenciais de cobrança são POR EMPRESA em empresa_configs.dados['cobranca'][<banco>]
# (agencia, conta, carteira, convenio, cedente_nome, cedente_documento, operacao).
COBRANCA_DRIVER=fake
# Conciliação contábil (CONSISA): URL da API; vazio = modo gate (sem chamada de rede).
CONSISA_API_URL=
# IBPT (Lei 12.741): URL do CSV regional mensal p/ `ibpt:atualizar` (vazio = no-op).
IBPT_CSV_URL=
# Pagamento online (eRede): 'erede' ativa o adquirente real (senão fake).
PAGAMENTO_DRIVER=fake
EREDE_API_URL=
EREDE_PV=
EREDE_TOKEN=
# Rastreamento GPS (SGCasa): 'sgcasa' ativa o real (senão fake).
MONITORA_DRIVER=fake
SGCASA_API_URL=
SGCASA_TOKEN=
# PIX (Itaú): habilita cobrança PIX real.
# PIX_DRIVER: 'fake' (BR Code sintético, dev/CI) ou o PSP real na homologação.
# Com driver real, a credencial é POR EMPRESA (empresa_configs) — fail-closed.
PIX_DRIVER=fake
PIX_ENABLED=false
PIX_CLIENT_ID=
# Push mobile (FCM) — P0: 'v1' ativa o FCM HTTP v1 (usa FIREBASE_CREDENTIALS/PROJECT_ID).
# 'fake' (padrão) não envia (CI/dev). FCM_SERVER_KEY é o legacy (depreciado).
FCM_DRIVER=fake
FCM_SERVER_KEY=
# Geocoding/Mapas:
GOOGLE_MAPS_KEY=

# P1 — Expiração dos tokens Sanctum dos apps (minutos). Padrão 30 dias.
SANCTUM_EXPIRATION=43200

# P0 — Tempo real (Laravel Reverb / WebSocket). Configurar ao habilitar broadcasting.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http

# ---------------------------------------------------------------------------
# Credenciais de bootstrap (seeders de deploy)
#
# EM PRODUCAO estas variaveis sao OBRIGATORIAS e exigem no minimo 12 caracteres:
# o seeder ABORTA o deploy se faltarem (fail-close). Fora de producao, deixar em
# branco faz o seeder GERAR uma senha aleatoria e ecoa-la no console.
# Nunca preencha aqui com um valor real — este arquivo e versionado.
# ---------------------------------------------------------------------------

# Admin do tenant (support = bypass total de RBAC). Troque no 1o acesso.
ADMIN_SEED_EMAIL=admin@gasemcasa.com
ADMIN_SEED_PASSWORD=

# P4 — SuperAdmin (operador da plataforma). Identidade SEPARADA dos usuarios de
# tenant e CROSS-TENANT: habilite o 2FA no 1o acesso.
SUPERADMIN_SEED_EMAIL=superadmin@gasemcasa.com
SUPERADMIN_SEED_PASSWORD=

# Usado so pelo AcessoMigracaoSeeder (ambiente carregado com dados migrados).
OPERADOR_SEED_PASSWORD=
