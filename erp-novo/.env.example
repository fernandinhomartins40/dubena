APP_NAME="ERP Gas em Casa"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Dev local/CI: sqlite (sem servidor). Produção: trocar para pgsql (abaixo).
DB_CONNECTION=sqlite
# --- PostgreSQL (banco NOVO) — produção/homologação ---
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=erp_novo
# DB_USERNAME=erp
# DB_PASSWORD=

# --- Banco LEGADO (somente leitura, usado pelo ETL) ---
LEGADO_DB_HOST=127.0.0.1
LEGADO_DB_PORT=5432
LEGADO_DB_DATABASE=ctrl
LEGADO_DB_USERNAME=ctrl
LEGADO_DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- GATES de integrações externas (default = fake/desligado; CI/homolog não precisam) ---
# Fiscal (SEFAZ): 'nfephp' ativa emissão real de NF-e/NFC-e (certificado A1 por empresa).
FISCAL_DRIVER=fake
# Cobrança/boleto (CNAB): 'caixa' (104) ou 'itau' (341) ativam o boleto real; senão fake.
# As credenciais de cobrança são POR EMPRESA em empresa_configs.dados['cobranca'][<banco>]
# (agencia, conta, carteira, convenio, cedente_nome, cedente_documento, operacao).
COBRANCA_DRIVER=fake
# Conciliação contábil (CONSISA): URL da API; vazio = modo gate (sem chamada de rede).
CONSISA_API_URL=
# IBPT (Lei 12.741): URL do CSV regional mensal p/ `ibpt:atualizar` (vazio = no-op).
IBPT_CSV_URL=
# Pagamento online (eRede): 'erede' ativa o adquirente real (senão fake).
PAGAMENTO_DRIVER=fake
EREDE_API_URL=
EREDE_PV=
EREDE_TOKEN=
# Rastreamento GPS (SGCasa): 'sgcasa' ativa o real (senão fake).
MONITORA_DRIVER=fake
SGCASA_API_URL=
SGCASA_TOKEN=
# PIX (Itaú): habilita cobrança PIX real.
PIX_ENABLED=false
PIX_CLIENT_ID=
# Push mobile (FCM):
FCM_SERVER_KEY=
# Geocoding/Mapas:
GOOGLE_MAPS_KEY=
