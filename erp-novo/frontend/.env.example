# Variáveis de build da SPA (Vite). Copie para `.env.local` e preencha.
# Tudo que começa com VITE_ é EMBUTIDO NO BUNDLE e fica visível a qualquer
# visitante — nunca coloque segredo aqui.

# Atalho "Preencher com acesso de demonstração" da tela de login.
# Só renderiza em `npm run dev` (import.meta.env.DEV) E com as duas preenchidas.
# Em build de produção o botão não existe, independente do que houver aqui.
VITE_DEMO_EMAIL=
VITE_DEMO_PASSWORD=

# Idem para o login do SuperAdmin (/superadmin) — acesso cross-tenant.
VITE_SA_DEMO_EMAIL=
VITE_SA_DEMO_PASSWORD=
