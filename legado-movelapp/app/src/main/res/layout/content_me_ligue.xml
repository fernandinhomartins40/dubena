<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ngbclear"
    android:theme="@style/AppTheme"
    app:layout_behavior="@string/appbar_scrolling_view_behavior"
    tools:context="br.inf.qti.movelapp.MeLigueActivity"
    tools:showIn="@layout/activity_me_ligue">


    <ProgressBar
        android:id="@+id/import_progress"
        style="?android:attr/progressBarStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <TextView
        android:id="@+id/txtImportProgress"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:gravity="top"
        android:textSize="12dp"
        android:lines="4"
        android:text=""
        android:textAppearance="?android:attr/textAppearanceMedium" />

    <ScrollView
        android:id="@+id/login_form"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">">


        <androidx.gridlayout.widget.GridLayout xmlns:android="http://schemas.android.com/apk/res/android"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            app:columnCount="3">

            <Space
                android:layout_width="0dp"
                app:layout_columnWeight="0.05"
                app:layout_gravity="fill_horizontal"
                android:gravity="center" />

            <LinearLayout
                android:id="@+id/email_meligue_form"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_columnWeight="0.9"
                android:layout_marginTop="0px"
                android:orientation="vertical">


                <androidx.gridlayout.widget.GridLayout xmlns:android="http://schemas.android.com/apk/res/android"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    app:columnCount="3">

                    <Space
                        android:layout_width="0dp"
                        app:layout_columnWeight="0.15"
                        app:layout_gravity="fill_horizontal"
                        android:background="?attr/colorPrimary"
                        android:gravity="center" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        app:layout_columnWeight="0.9"
                        android:layout_marginTop="50px"
                        android:background="?attr/colorPrimary"
                        android:orientation="vertical">

                    </LinearLayout>

                    <Space
                        android:layout_width="0dp"
                        app:layout_columnWeight="0.15"
                        app:layout_gravity="fill_horizontal"
                        android:background="?attr/colorPrimary"
                        android:gravity="center" />
                </androidx.gridlayout.widget.GridLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/field_meligue"
                    android:textColor="@color/ngbfont" />

                <EditText
                    android:id="@+id/txtMeligue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/retangulo"
                    android:hint="@string/field_meligue"
                    android:padding="15px"
                    android:lines="5"
                    android:textColor="@color/ngbfont"

                    />

                <ImageButton
                    android:id="@+id/btnEnviarMeligue"
                    style="?android:textAppearanceSmall"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="0.8"
                    android:layout_gravity="fill_horizontal"
                    android:layout_marginTop="16dp"
                    android:background="@color/ngbclear"
                    android:gravity="center"
                    android:paddingTop="20dp"
                    android:src="@drawable/bt_contato_interno2"
                    android:text="@string/action_sign_in"
                    android:textStyle="bold" />

            </LinearLayout>

            <Space
                android:layout_width="0dp"
                app:layout_columnWeight="0.05"
                app:layout_gravity="fill_horizontal"
                android:background="?attr/colorPrimary"
                android:gravity="center" />

        </androidx.gridlayout.widget.GridLayout>
    </ScrollView>



</androidx.constraintlayout.widget.ConstraintLayout>
