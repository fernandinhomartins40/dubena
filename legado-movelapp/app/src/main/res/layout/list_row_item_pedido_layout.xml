<?xml version="1.0" encoding="utf-8"?>

<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/retangulo3">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="New Text"
        android:textStyle="bold"
        android:textColor="#ffffff"
        android:id="@+id/txtProdutoItem" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="New Text"
        android:id="@+id/txtPrecoItem"
        android:textColor="#ffffff"
        android:layout_below="@+id/txtProdutoItem" />

    <TextView
        android:id="@+id/txtQuantidadeItem"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignBaseline="@+id/txtProdutoItem"
        android:layout_alignBottom="@+id/txtProdutoItem"
        android:layout_alignParentRight="true"
        android:text="teste"
        android:textColor="#ffffff"
        android:textStyle="bold"/>

    <TextView
        android:id="@+id/txtValorItem"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignBaseline="@+id/txtPrecoItem"
        android:layout_alignBottom="@+id/txtPrecoItem"
        android:layout_alignParentRight="true"
        android:text="teste"
        android:textColor="#ffffff"
        />


</RelativeLayout>