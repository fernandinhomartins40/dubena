<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ngbclear"
    android:theme="@style/AppTheme"
    app:layout_behavior="@string/appbar_scrolling_view_behavior"
    tools:context="br.inf.qti.movelapp.RegisterActivity"
    tools:showIn="@layout/activity_register">

    <ProgressBar
        android:id="@+id/registrationProgressBar"
        style="?android:attr/progressBarStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <TextView
        android:id="@+id/informationTextView"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:lines="4"
        android:text=""
        android:textAlignment="center"
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:textSize="12dp" />

    <ScrollView
        android:id="@+id/login_form"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">">


        <androidx.gridlayout.widget.GridLayout xmlns:android="http://schemas.android.com/apk/res/android"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">

            <Space
                android:layout_width="0dp"
                android:background="?attr/colorPrimary"
                android:gravity="center"
                app:layout_columnWeight="0.05"
                app:layout_gravity="fill_horizontal" />

            <LinearLayout
                android:id="@+id/email_login_form"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="80px"
                android:orientation="vertical"
                app:layout_columnWeight="0.9">


                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/prompt_servidor"
                    android:textColor="@color/ngbfont" />

                <EditText
                    android:id="@+id/servidorR"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/retangulo"
                    android:hint="@string/prompt_servidor"
                    android:imeActionId="@+id/login"
                    android:imeActionLabel="@string/action_sign_in_short"
                    android:imeOptions="actionUnspecified"
                    android:padding="15px"
                    android:textColor="@color/ngbfont"

                    />

                <LinearLayout
                    android:id="@+id/Layout5"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:weightSum="1">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="20px"
                        android:layout_weight="0.5"
                        android:text="@string/prompt_email" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.5"
                        android:text="@string/prompt_password" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/Layout6"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:weightSum="1">

                    <AutoCompleteTextView
                        android:id="@+id/emailR"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="20px"
                        android:layout_weight="0.5"
                        android:background="@drawable/retangulo"
                        android:hint="@string/prompt_email"
                        android:inputType="textEmailAddress"
                        android:maxLines="1"
                        android:padding="15px"
                        android:textColor="@color/ngbfont" />

                    <EditText
                        android:id="@+id/passwordR"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.5"
                        android:background="@drawable/retangulo"
                        android:hint="@string/prompt_password"
                        android:imeActionId="@+id/login"
                        android:imeActionLabel="@string/action_sign_in_short"
                        android:imeOptions="actionUnspecified"
                        android:inputType="textPassword"
                        android:maxLines="1"
                        android:padding="15px"
                        android:textColor="@color/ngbfont" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/Layout8"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:weightSum="1">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="20px"
                        android:layout_weight="0.5"
                        android:text="@string/prompt_cliente_id" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.5"
                        android:text="@string/prompt_revenda_id" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/Layout7"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:weightSum="1">

                    <EditText
                        android:id="@+id/cliente_idR"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="20px"
                        android:layout_weight="0.5"
                        android:background="@drawable/retangulo"
                        android:hint="@string/prompt_cliente_id"
                        android:imeActionId="@+id/login"
                        android:imeOptions="actionUnspecified"
                        android:inputType="number"
                        android:maxLines="1"
                        android:padding="15px"
                        android:textColor="@color/ngbfont" />

                    <EditText
                        android:id="@+id/revenda_idR"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.5"
                        android:background="@drawable/retangulo"
                        android:hint="@string/prompt_revenda_id"
                        android:imeActionId="@+id/login"
                        android:imeOptions="actionUnspecified"
                        android:inputType="number"
                        android:maxLines="1"
                        android:padding="15px"
                        android:textColor="@color/ngbfont" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:id="@+id/lblDescricaoR"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="@string/prompt_descricao_android"
                    android:textColor="@color/ngbfont" />

                <EditText
                    android:id="@+id/descricaoR"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/retangulo"
                    android:hint="@string/prompt_descricao_android"
                    android:imeActionId="@+id/login"
                    android:imeActionLabel="@string/action_sign_in_short"
                    android:imeOptions="actionUnspecified"
                    android:padding="15px"
                    android:textColor="@color/ngbfont"

                    />


                <ImageButton
                    android:id="@+id/btnRegistrar"
                    style="?android:textAppearanceSmall"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="0.8"
                    android:layout_gravity="fill_horizontal"
                    android:layout_marginTop="16dp"
                    android:background="@color/ngbclear"


                    android:gravity="center"
                    android:paddingTop="20dp"
                    android:src="@drawable/bt_registrar2"
                    android:text="@string/action_sign_in"
                    android:textStyle="bold" />

            </LinearLayout>

            <Space
                android:layout_width="0dp"
                android:background="?attr/colorPrimary"
                android:gravity="center"
                app:layout_columnWeight="0.05"
                app:layout_gravity="fill_horizontal" />

        </androidx.gridlayout.widget.GridLayout>
    </ScrollView>


</androidx.constraintlayout.widget.ConstraintLayout>
