<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="@string/appbar_scrolling_view_behavior"
    tools:context="br.inf.qti.movelapp.CadastroImportActivity"
    android:theme="@style/AppTheme"
    android:background="@color/ngbclear"
    tools:showIn="@layout/activity_cadastro_import">

    <ProgressBar
        android:id="@+id/import_progress"
        style="?android:attr/progressBarStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <TextView
        android:id="@+id/txtImportProgress"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:textAlignment="center"
        android:gravity="center"
        android:textSize="12dp"
        android:lines="4"
        android:text=""
        android:textAppearance="?android:attr/textAppearanceMedium" />

    <ScrollView
        android:id="@+id/login_form"
        android:layout_width="fill_parent"
        android:layout_marginTop="80px"
        android:layout_height="fill_parent">">


        <androidx.gridlayout.widget.GridLayout xmlns:android="http://schemas.android.com/apk/res/android"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            >

            <Space
                android:layout_width="0dp"
                app:layout_columnWeight="0.05"
                app:layout_gravity="fill_horizontal"
                android:background="?attr/colorPrimary"
                android:gravity="center" />

            <LinearLayout
                android:id="@+id/email_login_form"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_columnWeight="0.9"
                android:layout_marginTop="40px"
                android:orientation="vertical">


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/label_android_id"
                    android:textColor="@color/ngbfont"
                    android:id="@+id/lblIdImport"
                    android:textSize="16dp"
                    android:hint="@string/label_android_id" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/label_android_id"
                    android:textColor="@color/ngbfont"
                    android:id="@+id/lblServidor"
                    android:textSize="16dp"
                    android:hint="@string/label_android_id" />

                <ImageButton
                    android:id="@+id/btnImportar"
                    style="?android:textAppearanceSmall"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="0.8"
                    android:layout_gravity="fill_horizontal"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:paddingTop="20dp"
                    android:src="@drawable/bt_importar2"
                    android:text="@string/action_sign_in"
                    android:background="@color/ngbclear"
                    android:textStyle="bold" />

            </LinearLayout>

            <Space
                android:layout_width="0dp"
                app:layout_columnWeight="0.05"
                app:layout_gravity="fill_horizontal"
                android:background="?attr/colorPrimary"
                android:gravity="center" />

        </androidx.gridlayout.widget.GridLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
