{
    "name": "laravel/laravel",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "type": "project",
    "require": {
        "php": ">=7.4",
        "league/flysystem": "1.0.65",
        "laravel/framework": "5.8.*",
        "laravelcollective/html": "^5.8",
        "intervention/image": "^2.3",
        "milon/barcode": "^5.2",
        "venturecraft/revisionable": "1.*",
        "maatwebsite/excel": "~2.1.0",
        "doctrine/dbal": "^2.13",
        "jenssegers/date": "^3.2",
        "mpdf/mpdf": "^8.0",
        "barryvdh/laravel-dompdf": "^0.8.5",
        "laravel/passport": "^3.0",
        "guzzlehttp/guzzle": "^6.3",
        "eduardokum/laravel-boleto": "^0.9.4",
        "zendframework/zend-servicemanager": "^3.3",
        "nfephp-org/sped-nfe": "5.2.1",
        "nfephp-org/sped-da": "^0.1",
        "tecnickcom/tc-lib-barcode": "1.15",
        "clue/graph-uml": "dev-master",
        "cboden/ratchet": "^0.4.1",
        "ratchet/pawl": "^0.3.4",
        "phpoffice/phpspreadsheet": "^1.11",
        "lcobucci/jwt": "3.3.3",
        "developersrede/erede-php": "4.2",
        "phpoffice/phppresentation": "1.2.0",
        "beccha/ofxparser": "^2.1"
    },
    "require-dev": {
        "fzaninotto/faker": "~1.4",
        "mockery/mockery": "0.9.*",
        "phpunit/phpunit": "^7.5",
        "symfony/css-selector": "2.8.*|3.0.*",
        "symfony/dom-crawler": "2.8.*|3.0.*",
        "barryvdh/laravel-ide-helper": "^2.6"
    },
    "autoload": {
        "classmap": [
            "database"
        ],
        "psr-4": {
            "App\\": "app/",
            "Tests\\": "tests/"
        },
        "files": [
            "app/Helpers/customHelper.php"
        ]
    },
    "autoload-dev": {
        "classmap": [
            "tests/TestCase.php"
        ]
    },
    "scripts": {
        "post-root-package-install": [
            "php -r \"copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "php artisan key:generate"
        ],
        "post-install-cmd": [
            "Illuminate\\Foundation\\ComposerScripts::postInstall",
            "php artisan optimize"
        ],
        "post-update-cmd": [
            "Illuminate\\Foundation\\ComposerScripts::postUpdate",
            "php artisan optimize"
        ]
    },
    "config": {
        "preferred-install": "dist",
        "allow-plugins": {
            "kylekatarnls/update-helper": true
        }
    }
}
