{
    "name": "laravel/laravel",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "type": "project",
    "require": {
        "php": ">=7.4",
        "league/flysystem": "^1.1",
        "laravel/framework": "^8.0",
        "laravel/helpers": "^1.4",
        "laravelcollective/html": "^6.2",
        "intervention/image": "^2.5",
        "milon/barcode": "^8.0",
        "venturecraft/revisionable": "^1.40",
        "maatwebsite/excel": "^3.1",
        "doctrine/dbal": "^2.13",
        "jenssegers/date": "^4.0",
        "mpdf/mpdf": "^8.0",
        "barryvdh/laravel-dompdf": "^2.2",
        "laravel/passport": "^10.4",
        "guzzlehttp/guzzle": "^6.3",
        "eduardokum/laravel-boleto": "^0.9.4",
        "nfephp-org/sped-nfe": "5.2.1",
        "nfephp-org/sped-da": "^0.1",
        "tecnickcom/tc-lib-barcode": "1.15",
        "clue/graph-uml": "dev-master",
        "cboden/ratchet": "^0.4.1",
        "ratchet/pawl": "^0.3.4",
        "phpoffice/phpspreadsheet": "^1.11",
        "lcobucci/jwt": "^4.0",
        "developersrede/erede-php": "4.2",
        "phpoffice/phppresentation": "1.2.0",
        "beccha/ofxparser": "^2.1"
    },
    "require-dev": {
        "fakerphp/faker": "^1.9.1",
        "mockery/mockery": "^1.4.4",
        "phpunit/phpunit": "^9.5",
        "barryvdh/laravel-ide-helper": "^2.6"
    },
    "autoload": {
        "classmap": [
            "database/seeds",
            "database/seeds_api",
            "database/factories"
        ],
        "psr-4": {
            "App\\": "app/",
            "Tests\\": "tests/"
        },
        "files": [
            "app/Helpers/customHelper.php"
        ]
    },
    "autoload-dev": {
        "classmap": [
            "tests/TestCase.php"
        ]
    },
    "scripts": {
        "post-root-package-install": [
            "php -r \"copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "php artisan key:generate"
        ],
        "post-install-cmd": [
            "Illuminate\\Foundation\\ComposerScripts::postInstall",
            "php artisan optimize"
        ],
        "post-update-cmd": [
            "Illuminate\\Foundation\\ComposerScripts::postUpdate",
            "php artisan optimize"
        ]
    },
    "config": {
        "preferred-install": "dist",
        "allow-plugins": {
            "kylekatarnls/update-helper": true
        }
    }
}
