{
    "name": "laravel/laravel",
    "description": "The Laravel Framework.",
    "keywords": ["framework", "laravel"],
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^8.2",
        "league/flysystem": "^3.0",
        "laravel/framework": "^12.0",
        "laravel/helpers": "^1.7",
        "rdx/laravelcollective-html": "^6.10",
        "intervention/image": "^2.7",
        "milon/barcode": "^13.0",
        "venturecraft/revisionable": "^1.40",
        "maatwebsite/excel": "^3.1",
        "doctrine/dbal": "^4.0",
        "mpdf/mpdf": "^8.0",
        "barryvdh/laravel-dompdf": "^3.1",
        "laravel/passport": "^13.0",
        "guzzlehttp/guzzle": "^7.8",
        "eduardokum/laravel-boleto": "^0.11.2",
        "eduardokum/laravel-mail-auto-embed": "dev-master",
        "nfephp-org/sped-nfe": "5.2.1",
        "nfephp-org/sped-da": "^0.1",
        "tecnickcom/tc-lib-barcode": "1.15",
        "clue/graph-uml": "dev-master",
        "cboden/ratchet": "^0.4.1",
        "ratchet/pawl": "^0.3.4",
        "phpoffice/phpspreadsheet": "^1.29.4",
        "developersrede/erede-php": "^5.2",
        "phpoffice/phppresentation": "1.2.0",
        "beccha/ofxparser": "^2.1",
        "filament/filament": "^3.2",
        "spatie/laravel-permission": "^8.0",
        "laravel/sanctum": "^4.3"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "mockery/mockery": "^1.6",
        "phpunit/phpunit": "^11.0",
        "barryvdh/laravel-ide-helper": "^3.0"
    },
    "autoload": {
        "classmap": [
            "database/seeds",
            "database/seeds_api",
            "database/factories"
        ],
        "psr-4": {
            "App\\": "app/",
            "Tests\\": "tests/"
        },
        "files": [
            "app/Helpers/customHelper.php"
        ]
    },
    "autoload-dev": {
        "classmap": [
            "tests/TestCase.php"
        ]
    },
    "scripts": {
        "post-root-package-install": [
            "php -r \"copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "php artisan key:generate"
        ],
        "post-install-cmd": [
            "Illuminate\\Foundation\\ComposerScripts::postInstall",
            "php artisan optimize"
        ],
        "post-update-cmd": [
            "Illuminate\\Foundation\\ComposerScripts::postUpdate",
            "php artisan optimize"
        ],
        "post-autoload-dump": [
            "@php artisan filament:upgrade"
        ]
    },
    "config": {
        "preferred-install": "dist",
        "allow-plugins": {
            "kylekatarnls/update-helper": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
