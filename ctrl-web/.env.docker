# ──────────────────────────────────────────────────────────────────────────
# Template de ambiente para o container (dev/staging) do ctrl-web (ERP).
# O entrypoint copia para .env na 1ª subida e gera a APP_KEY.
# ⚠️ Valores de DEV (fake). NÃO colocar credenciais reais aqui.
# ⚠️ Antes de EXPOR na VPS: APP_DEBUG=false (ver README.docker.md).
# ──────────────────────────────────────────────────────────────────────────
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8082
# APP_KEY não é definida aqui de propósito (o entrypoint gera no .env real).

# Banco principal: PostgreSQL (saída do Oracle — Fase 3)
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=ctrl
DB_USERNAME=ctrl
DB_PASSWORD=ctrl_dev_pwd

# Oracle: NÃO configurado (em eliminação). Vars separadas p/ não colidir com pgsql.
# DB_HOST_ORACLE / DB_PORT_ORACLE / DB_DATABASE_ORACLE / DB_USERNAME_ORACLE / DB_PASSWORD_ORACLE

# Banco monitoramento (mysql) — preencher só se necessário em dev
DB_HOST_MONITORA=127.0.0.1
DB_PORT_MONITORA=3306
DB_DATABASE_MONITORA=monitora
DB_USERNAME_MONITORA=
DB_PASSWORD_MONITORA=

CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_DRIVER=sync

# FASE 1 (segurança — S3): token compartilhado para validar a origem do
# webhook PIX. Em dev é fake; na VPS use segredo forte e configure no Itaú.
PIX_WEBHOOK_TOKEN=dev_pix_webhook_token_change_me

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_DRIVER=log
MAIL_HOST=null
MAIL_PORT=null
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null

DEFAULT_USER_SYSTEM=dev@local.test
DEFAULT_PASSWORD_SYSTEM=devpassword
DEFAULT_USER_ID=1

# FASE 5 (unificação): módulo Api (ex-api-app-gc) aponta para o mesmo Postgres
# do ERP. Tabelas espelho *_importacao permanecem por ora.
DB_DRIVER_API=pgsql
DB_HOST_API=db
DB_PORT_API=5432
DB_DATABASE_API=ctrl
DB_USERNAME_API=ctrl
DB_PASSWORD_API=ctrl_dev_pwd

# Usuário admin criado pelo DeployAdminSeeder (trocar a senha no 1º acesso)
ADMIN_SEED_EMAIL=admin
ADMIN_SEED_PASSWORD=admin1234
