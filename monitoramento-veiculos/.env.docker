# ──────────────────────────────────────────────────────────────────────────
# Template de ambiente para o container (dev/staging).
# O entrypoint copia este arquivo para .env na 1ª subida e gera a APP_KEY.
# ⚠️ Valores de DEV (fake). NÃO colocar credenciais reais aqui.
# ⚠️ Antes de EXPOR na VPS: trocar APP_DEBUG para false (ver README.docker.md).
# ──────────────────────────────────────────────────────────────────────────
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
# APP_KEY não é definida aqui de propósito: o entrypoint gera a chave no .env real.
# (Definir APP_KEY vazia via env_file teria precedência e quebraria o Encrypter.)

# Banco principal do monitoramento (MySQL do compose, dados fake)
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=monitora
DB_USERNAME=monitora
DB_PASSWORD=monitora_dev_pwd

# 2º MySQL (sgc_dubena) — preencher só quando necessário em dev
DB_HOST2=db
DB_PORT2=3306
DB_DATABASE2=sgc_dubena
DB_USERNAME2=monitora
DB_PASSWORD2=monitora_dev_pwd

# Oracle do ERP (oracle/oracle3) — NÃO configurado no piloto.
# Rotas que dependem dele (SearchController) ficam inoperantes até a Fase 3.

CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_DRIVER=sync

# FASE 1 (segurança): token compartilhado para integração S2S (Traccar → /savePosition).
# Em dev é um valor fake; na VPS use um segredo forte e rotacionável.
INTEGRATION_TOKEN=dev_integration_token_change_me

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_DRIVER=log
MAIL_HOST=null
MAIL_PORT=null
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
