# Configuração do app (F0 — segurança). Copie para `.env` e preencha.
# `.env` está no .gitignore — NUNCA versione segredos reais.

# Ambiente: local | homolog | prod
APP_ENV=prod

# Base da API do ERP-NOVO (com a barra final). Deve ser HTTPS em homolog/prod.
# Ex. local:   http://192.168.0.108:8000/api/
# Ex. homolog: https://homolog.seu-erp.com.br/api/
# Ex. prod:    https://app.seu-erp.com.br/api/
API_URL=https://app.seu-erp.com.br/api/

# Chave do Google Maps / Geocoding. NUNCA versione o valor: em build EAS ela vem
# do secret (`eas secret:create --name GOOGLE_MAPS_API_KEY`), referenciado no
# eas.json. No console do Google, restrinja por package name + SHA-1 (Android),
# bundle ID (iOS) e por API (Maps SDK, Geocoding).
GOOGLE_MAPS_API_KEY=

# Habilita atalhos de debug (pula SMS real etc.). Sempre "false" em prod.
APP_DEBUG=false

# Empresa (tenant) que este build atende. Enviado no login do cliente (F1) para o
# ERP-NOVO resolver o cliente pelo telefone verificado. Obrigatório em homolog/prod.
EMPRESA_ID=

# P8 — tempo real (Laravel Reverb, protocolo Pusher). Opcional: sem isto, o
# acompanhamento do pedido usa polling. Em prod, aponte para o Reverb do ERP-NOVO.
REVERB_APP_KEY=
REVERB_HOST=
REVERB_PORT=443
REVERB_SCHEME=https
